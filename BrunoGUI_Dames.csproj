<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <!-- Numéro de version de l'application (« À propos », propriétés de l'exe) : à changer à chaque version publiée ; le tag Git vX.YY doit lui correspondre -->
    <Version>1.12</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Krypton.Toolkit" Version="105.26.7.201" />
  </ItemGroup>
  <ItemGroup>
    <!-- Le projet de tests pilote la vraie fenêtre par les points de ReglagesDeTest.cs -->
    <InternalsVisibleTo Include="BrunoGUI_Dames.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Le projet de tests a son propre .csproj : on l'exclut de l'application -->
    <Compile Remove="Tests\**" />
    <EmbeddedResource Remove="Tests\**" />
    <None Remove="Tests\**" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Dames_Scan31_FabienLetouzey\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <!-- Aide (page HTML et captures d'écran), ouverte dans le navigateur par le bouton Aide ou F1 -->
    <None Update="Aide\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Traductions anglaises de l'affichage (Texte) : le français est dans les sources, l'anglais seulement dans ce fichier -->
    <None Update="Langues\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Content Include="Resources\DameBlanche.png" />
    <Content Include="Resources\DameNoire.png" />
  </ItemGroup>
</Project>